generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["app"]
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED

  @@schema("app")
}

enum Currency {
  PEN
  USD

  @@schema("app")
}

enum AccountType {
  SAVINGS
  CHECKING
  CTS
  TERM_DEPOSIT

  @@schema("app")
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  CLOSED

  @@schema("app")
}

enum TransferKind {
  OWN_ACCOUNTS
  THIRD_PARTY

  @@schema("app")
}

enum CardKind {
  DEBIT
  CREDIT

  @@schema("app")
}

enum CardStatus {
  ACTIVE
  BLOCKED
  EXPIRED
  CANCELLED

  @@schema("app")
}

enum CardNetwork {
  VISA
  MASTERCARD
  AMEX

  @@schema("app")
}

enum CardFormat {
  PHYSICAL
  DIGITAL

  @@schema("app")
}

enum TransactionType {
  DEPOSIT
  TRANSFER
  SERVICE_PAYMENT

  @@schema("app")
}

enum TransactionDirection {
  CREDIT
  DEBIT

  @@schema("app")
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED

  @@schema("app")
}

enum LoanApplicationStatus {
  PENDING_REVIEW
  CANCELLED
  REJECTED
  APPROVED

  @@schema("app")
}

enum PromotionCategory {
  DINING
  ENTERTAINMENT
  SHOPPING
  TRAVEL
  OTHER

  @@schema("app")
}

enum ServiceProviderStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE

  @@schema("app")
}

enum PaymentReferenceType {
  CUSTOMER_CODE
  SUPPLY_NUMBER
  CONTRACT_NUMBER
  DOCUMENT_NUMBER
  PHONE_NUMBER
  OTHER

  @@schema("app")
}

enum ServiceDebtStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED

  @@schema("app")
}

enum PromotionRedemptionMethod {
  SHOW_CODE
  ONLINE_CODE
  AUTOMATIC

  @@schema("app")
}

enum PromotionVoucherStatus {
  ISSUED
  USED
  EXPIRED

  @@schema("app")
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  documentNumber       String                @unique @db.VarChar(8)
  email                String                @unique @db.VarChar(254)
  passwordHash         String
  firstName            String?               @db.VarChar(100)
  lastName             String?               @db.VarChar(100)
  phoneNumber          String?               @unique @db.VarChar(9)
  phoneVerifiedAt      DateTime?
  marketingOptIn       Boolean               @default(false)
  status               UserStatus            @default(ACTIVE)
  lastLoginAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  accounts             Account[]
  cards                Card[]
  initiatedTransfers   Transfer[]
  servicePayments      ServicePayment[]
  savedServicePayments SavedServicePayment[]
  biometricCredentials BiometricCredential[]
  phoneChallenge       PhoneChallenge?
  plinEnrollment       PlinEnrollment?
  plinPayments         PlinPayment[]         @relation("PlinSender")
  loanApplications     LoanApplication[]
  favoritePromotions   PromotionFavorite[]
  customerDetails      CustomerDetails?
  addresses            CustomerAddress[]
  plinFavorites        PlinFavorite[]
  promotionVouchers    PromotionVoucher[]

  @@index([documentNumber, email])
  @@map("users")
  @@schema("app")
}

model CustomerDetails {
  userId          String   @id @db.Uuid
  preferredName   String?  @db.VarChar(100)
  occupation      String?  @db.VarChar(100)
  nationalityCode String?  @db.Char(2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_details")
  @@schema("app")
}

model CustomerAddress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  label       String   @db.VarChar(40)
  line1       String   @db.VarChar(200)
  district    String   @db.VarChar(100)
  province    String   @db.VarChar(100)
  department  String   @db.VarChar(100)
  countryCode String   @default("PE") @db.Char(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("customer_addresses")
  @@schema("app")
}

model PhoneChallenge {
  userId      String   @id @db.Uuid
  phoneNumber String   @db.VarChar(9)
  codeHash    String   @db.Char(64)
  salt        String   @db.Char(32)
  expiresAt   DateTime
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("phone_challenges")
  @@schema("app")
}

model PlinEnrollment {
  userId      String   @id @db.Uuid
  phoneNumber String   @unique @db.VarChar(9)
  accountId   String   @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account  @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)

  @@index([accountId])
  @@map("plin_enrollments")
  @@schema("app")
}

model PlinPayment {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  transferId         String   @unique @db.Uuid
  recipientPhone     String   @db.VarChar(9)
  senderPhone        String?  @db.VarChar(9)
  idempotencyKey     String   @db.VarChar(80)
  requestFingerprint String   @db.Char(64)
  amount             Decimal  @db.Decimal(14, 2)
  createdAt          DateTime @default(now())
  user               User     @relation("PlinSender", fields: [userId], references: [id], onDelete: Restrict)
  transfer           Transfer @relation(fields: [transferId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@map("plin_payments")
  @@schema("app")
}

model PlinFavorite {
  userId           String   @db.Uuid
  phoneNumber      String   @db.VarChar(9)
  alias            String?  @db.VarChar(80)
  preferredNetwork String   @default("PLIN") @db.VarChar(12)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, phoneNumber])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("plin_favorites")
  @@schema("app")
}

model LoanApplication {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @db.Uuid
  destinationAccountId String                @db.Uuid
  idempotencyKey       String                @db.VarChar(80)
  requestFingerprint   String                @db.Char(64)
  principal            Decimal               @db.Decimal(14, 2)
  annualEffectiveRate  Decimal               @db.Decimal(7, 4)
  monthlyPayment       Decimal               @db.Decimal(14, 2)
  totalRepayment       Decimal               @db.Decimal(14, 2)
  months               Int
  status               LoanApplicationStatus @default(PENDING_REVIEW)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  destinationAccount   Account               @relation(fields: [destinationAccountId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@map("loan_applications")
  @@schema("app")
}

model Promotion {
  id               String                    @id @default(uuid()) @db.Uuid
  title            String                    @db.VarChar(120)
  description      String                    @db.VarChar(500)
  category         PromotionCategory
  imageUrl         String?                   @db.VarChar(500)
  termsUrl         String?                   @db.VarChar(500)
  startsAt         DateTime
  endsAt           DateTime
  isActive         Boolean                   @default(true)
  priority         Int                       @default(0)
  merchantId       String?                   @db.Uuid
  redemptionMethod PromotionRedemptionMethod @default(AUTOMATIC)
  codePrefix       String?                   @db.VarChar(12)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  favorites        PromotionFavorite[]
  vouchers         PromotionVoucher[]
  merchant         PromotionMerchant?        @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([isActive, startsAt, endsAt, priority])
  @@index([merchantId])
  @@map("promotions")
  @@schema("app")
}

model PromotionMerchant {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @unique @db.VarChar(120)
  logoUrl    String?     @db.VarChar(500)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  promotions Promotion[]

  @@map("promotion_merchants")
  @@schema("app")
}

model PromotionVoucher {
  id          String                 @id @default(uuid()) @db.Uuid
  promotionId String                 @db.Uuid
  userId      String                 @db.Uuid
  code        String                 @unique @db.VarChar(40)
  status      PromotionVoucherStatus @default(ISSUED)
  issuedAt    DateTime               @default(now())
  expiresAt   DateTime
  promotion   Promotion              @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([promotionId, userId])
  @@index([userId, issuedAt(sort: Desc)])
  @@map("promotion_vouchers")
  @@schema("app")
}

model PromotionFavorite {
  userId      String    @db.Uuid
  promotionId String    @db.Uuid
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([userId, promotionId])
  @@index([promotionId])
  @@map("promotion_favorites")
  @@schema("app")
}

model BiometricCredential {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  deviceId        String    @db.VarChar(128)
  tokenHash       String    @unique @db.Char(64)
  credentialProof String    @db.VarChar(64)
  expiresAt       DateTime
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([expiresAt])
  @@map("biometric_credentials")
  @@schema("app")
}

model Account {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @db.Uuid
  displayName       String                @db.VarChar(100)
  accountNumber     String                @unique @db.VarChar(20)
  balance           Decimal               @default(0) @db.Decimal(14, 2)
  currency          Currency              @default(PEN)
  type              AccountType           @default(SAVINGS)
  accountTypeId     String                @default("50000000-0000-4000-8000-000000000001") @db.Uuid
  status            AccountStatus         @default(ACTIVE)
  cci               String                @unique @db.Char(20)
  closedAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  outgoingTransfers Transfer[]            @relation("TransferSource")
  incomingTransfers Transfer[]            @relation("TransferDestination")
  servicePayments   ServicePayment[]
  accountType       AccountTypeDefinition @relation(fields: [accountTypeId, type], references: [id, type], onDelete: Restrict)
  cardLinks         AccountCard[]
  plinEnrollments   PlinEnrollment[]
  loanApplications  LoanApplication[]

  @@unique([id, userId])
  @@index([userId, currency])
  @@index([userId, status, accountTypeId])
  @@map("accounts")
  @@schema("app")
}

model AccountTypeDefinition {
  id                  String      @id @default(uuid()) @db.Uuid
  code                String      @unique @db.VarChar(40)
  name                String      @db.VarChar(100)
  description         String      @db.VarChar(300)
  type                AccountType
  supportedCurrencies Currency[]
  allowsDebits        Boolean     @default(true)
  isActive            Boolean     @default(true)
  displayOrder        Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  accounts            Account[]

  @@unique([id, type])
  @@index([isActive, displayOrder])
  @@map("account_types")
  @@schema("app")
}

model CardType {
  id           String      @id @default(uuid()) @db.Uuid
  code         String      @unique @db.VarChar(40)
  name         String      @db.VarChar(100)
  description  String      @db.VarChar(300)
  kind         CardKind
  network      CardNetwork
  isActive     Boolean     @default(true)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  cards        Card[]

  @@unique([id, kind])
  @@index([isActive, kind, displayOrder])
  @@map("card_types")
  @@schema("app")
}

model Card {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  cardTypeId     String              @db.Uuid
  kind           CardKind
  lastFour       String              @db.Char(4)
  displayName    String              @db.VarChar(100)
  status         CardStatus          @default(ACTIVE)
  format         CardFormat          @default(PHYSICAL)
  expiresAt      DateTime            @db.Date
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  cardType       CardType            @relation(fields: [cardTypeId, kind], references: [id, kind], onDelete: Restrict)
  accountLinks   AccountCard[]
  creditBalances CardCreditBalance[]

  @@unique([id, userId, kind])
  @@unique([id, kind])
  @@index([userId, status, kind])
  @@map("cards")
  @@schema("app")
}

model AccountCard {
  accountId String   @db.Uuid
  cardId    String   @db.Uuid
  userId    String   @db.Uuid
  kind      CardKind @default(DEBIT)
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  card      Card     @relation(fields: [cardId, userId, kind], references: [id, userId, kind], onDelete: Restrict)

  @@id([accountId, cardId])
  @@index([cardId])
  @@map("account_cards")
  @@schema("app")
}

model CardCreditBalance {
  cardId             String   @db.Uuid
  currency           Currency
  kind               CardKind @default(CREDIT)
  creditLimit        Decimal  @db.Decimal(14, 2)
  outstandingBalance Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt          DateTime @updatedAt
  card               Card     @relation(fields: [cardId, kind], references: [id, kind], onDelete: Restrict)

  @@id([cardId, currency])
  @@map("card_credit_balances")
  @@schema("app")
}

model Transaction {
  id             String               @id @default(uuid()) @db.Uuid
  accountId      String               @db.Uuid
  transferId     String?              @db.Uuid
  type           TransactionType
  direction      TransactionDirection
  status         TransactionStatus    @default(COMPLETED)
  amount         Decimal              @db.Decimal(14, 2)
  currency       Currency
  description    String               @db.VarChar(160)
  reference      String?              @db.VarChar(80)
  occurredAt     DateTime             @default(now())
  account        Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transfer       Transfer?            @relation(fields: [transferId], references: [id])
  servicePayment ServicePayment?

  @@unique([transferId, direction])
  @@index([accountId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([transferId])
  @@map("transactions")
  @@schema("app")
}

model Transfer {
  id                   String            @id @default(uuid()) @db.Uuid
  sourceAccountId      String            @db.Uuid
  destinationAccountId String            @db.Uuid
  userId               String            @db.Uuid
  kind                 TransferKind
  operationNumber      String            @unique @db.VarChar(32)
  idempotencyKey       String            @db.VarChar(80)
  requestFingerprint   String            @db.Char(64)
  amount               Decimal           @db.Decimal(14, 2)
  currency             Currency
  status               TransactionStatus @default(COMPLETED)
  description          String?           @db.VarChar(160)
  createdAt            DateTime          @default(now())
  completedAt          DateTime?
  sourceAccount        Account           @relation("TransferSource", fields: [sourceAccountId, userId], references: [id, userId])
  destinationAccount   Account           @relation("TransferDestination", fields: [destinationAccountId], references: [id])
  transactions         Transaction[]
  user                 User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  plinPayment          PlinPayment?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([sourceAccountId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([destinationAccountId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("transfers")
  @@schema("app")
}

model ServicePayment {
  id                   String            @id @default(uuid()) @db.Uuid
  userId               String            @db.Uuid
  accountId            String            @db.Uuid
  serviceAgreementId   String            @db.Uuid
  debtId               String?           @db.Uuid
  transactionId        String            @unique @db.Uuid
  operationNumber      String            @unique @db.VarChar(32)
  idempotencyKey       String            @db.VarChar(80)
  requestFingerprint   String            @db.Char(64)
  customerReference    String            @db.VarChar(80)
  providerNameSnapshot String            @db.VarChar(120)
  serviceNameSnapshot  String            @db.VarChar(120)
  amount               Decimal           @db.Decimal(14, 2)
  commissionAmount     Decimal           @default(0) @db.Decimal(14, 2)
  totalAmount          Decimal           @db.Decimal(14, 2)
  currency             Currency
  status               TransactionStatus @default(COMPLETED)
  paidAt               DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  user                 User              @relation(fields: [userId], references: [id])
  account              Account           @relation(fields: [accountId], references: [id])
  serviceAgreement     ServiceAgreement  @relation(fields: [serviceAgreementId], references: [id])
  debt                 ServiceDebt?      @relation(fields: [debtId], references: [id])
  transaction          Transaction       @relation(fields: [transactionId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
  @@index([serviceAgreementId, customerReference])
  @@index([debtId])
  @@map("service_payments")
  @@schema("app")
}

model ServiceCategory {
  id           String            @id @default(uuid()) @db.Uuid
  code         String            @unique @db.VarChar(40)
  name         String            @db.VarChar(80)
  description  String?           @db.VarChar(240)
  iconKey      String            @db.VarChar(60)
  displayOrder Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  providers    ServiceProvider[]

  @@index([isActive, displayOrder])
  @@map("service_categories")
  @@schema("app")
}

model ServiceProvider {
  id            String                @id @default(uuid()) @db.Uuid
  categoryId    String                @db.Uuid
  code          String                @unique @db.VarChar(50)
  name          String                @db.VarChar(120)
  shortName     String                @db.VarChar(60)
  legalName     String?               @db.VarChar(180)
  logoUrl       String?               @db.VarChar(500)
  searchAliases String[]              @default([])
  displayOrder  Int                   @default(0)
  status        ServiceProviderStatus @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  category      ServiceCategory       @relation(fields: [categoryId], references: [id])
  agreements    ServiceAgreement[]

  @@index([categoryId, status, displayOrder])
  @@index([status, name])
  @@map("service_providers")
  @@schema("app")
}

model ServiceAgreement {
  id                     String                @id @default(uuid()) @db.Uuid
  providerId             String                @db.Uuid
  code                   String                @unique @db.VarChar(60)
  name                   String                @db.VarChar(120)
  description            String?               @db.VarChar(240)
  referenceLabel         String                @db.VarChar(80)
  referenceType          PaymentReferenceType
  referencePattern       String?               @db.VarChar(160)
  referenceMinLength     Int                   @default(1)
  referenceMaxLength     Int                   @default(80)
  supportsDebtInquiry    Boolean               @default(true)
  supportsPartialPayment Boolean               @default(false)
  currency               Currency              @default(PEN)
  commissionAmount       Decimal               @default(0) @db.Decimal(14, 2)
  minimumAmount          Decimal?              @db.Decimal(14, 2)
  maximumAmount          Decimal?              @db.Decimal(14, 2)
  isActive               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  provider               ServiceProvider       @relation(fields: [providerId], references: [id])
  debts                  ServiceDebt[]
  payments               ServicePayment[]
  savedPayments          SavedServicePayment[]

  @@index([providerId, isActive, name])
  @@map("service_agreements")
  @@schema("app")
}

model ServiceDebt {
  id                   String            @id @default(uuid()) @db.Uuid
  serviceAgreementId   String            @db.Uuid
  customerReference    String            @db.VarChar(80)
  invoiceNumber        String            @db.VarChar(80)
  description          String            @db.VarChar(160)
  amount               Decimal           @db.Decimal(14, 2)
  minimumPaymentAmount Decimal?          @db.Decimal(14, 2)
  currency             Currency
  issuedAt             DateTime
  dueDate              DateTime
  status               ServiceDebtStatus @default(PENDING)
  paidAt               DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  serviceAgreement     ServiceAgreement  @relation(fields: [serviceAgreementId], references: [id])
  payments             ServicePayment[]

  @@unique([serviceAgreementId, invoiceNumber])
  @@index([serviceAgreementId, customerReference, status, dueDate])
  @@map("service_debts")
  @@schema("app")
}

model SavedServicePayment {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @db.Uuid
  serviceAgreementId String           @db.Uuid
  alias              String           @db.VarChar(80)
  customerReference  String           @db.VarChar(80)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceAgreement   ServiceAgreement @relation(fields: [serviceAgreementId], references: [id])

  @@unique([userId, serviceAgreementId, customerReference])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("saved_service_payments")
  @@schema("app")
}
