APP_PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10&schema=app
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=app
SIMULATION_ENABLED=true
INSTANCE_NAME=local
JWT_SECRET=replace-with-at-least-32-characters
AUTH_SESSION_PEPPER=use-a-different-secret-with-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=2592000
SESSION_CACHE_DRIVER=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
