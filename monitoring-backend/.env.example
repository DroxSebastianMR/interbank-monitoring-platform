MONITORING_PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=monitoring
REDIS_HOST=localhost
REDIS_PORT=6379
AI_SERVICE_URL=http://localhost:8000
APP_BACKEND_URL=http://localhost:8080
JWT_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
DASHBOARD_ADMIN_EMPLOYEE_CODE=
DASHBOARD_ADMIN_EMAIL=
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_ADMIN_FIRST_NAME=
DASHBOARD_ADMIN_LAST_NAME=
MONITOR_INTERVAL_MS=10000
MONITOR_TIMEOUT_MS=3000
LATENCY_THRESHOLD_MS=1000
MAX_HEALTH_FAILURES=2
CORS_ORIGINS=http://localhost:5173
