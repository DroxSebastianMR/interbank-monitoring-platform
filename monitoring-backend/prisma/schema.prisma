generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["monitoring"]
}

enum ServiceStatus {
  OPERATIONAL
  DEGRADED
  UNAVAILABLE
  RECOVERING

  @@schema("monitoring")
}

enum EmployeeStatus {
  ACTIVE
  DISABLED

  @@schema("monitoring")
}

model Employee {
  id                     String                  @id @default(uuid()) @db.Uuid
  employeeCode           String                  @unique @map("employee_code") @db.VarChar(30)
  corporateEmail         String                  @unique @map("corporate_email") @db.VarChar(254)
  passwordHash           String                  @map("password_hash") @db.VarChar(255)
  firstName              String                  @map("first_name") @db.VarChar(80)
  lastName               String                  @map("last_name") @db.VarChar(120)
  jobTitle               String?                 @map("job_title") @db.VarChar(120)
  department             String?                 @db.VarChar(120)
  status                 EmployeeStatus          @default(ACTIVE)
  failedLoginAttempts    Int                     @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime?               @map("locked_until")
  lastLoginAt            DateTime?               @map("last_login_at")
  passwordChangedAt      DateTime                @default(now()) @map("password_changed_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  roles                  EmployeeRole[]
  sessions               AuthSession[]
  auditLogs              AuditLog[]
  assistantConversations AssistantConversation[]
  notifications          Notification[]

  @@index([status])
  @@map("employees")
  @@schema("monitoring")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(60)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(true) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  employees   EmployeeRole[]
  permissions RolePermission[]

  @@map("roles")
  @@schema("monitoring")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  resource    String           @db.VarChar(60)
  action      String           @db.VarChar(40)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
  @@schema("monitoring")
}

model EmployeeRole {
  employeeId String   @map("employee_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([employeeId, roleId])
  @@index([roleId])
  @@map("employee_roles")
  @@schema("monitoring")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
  @@schema("monitoring")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
  @@schema("monitoring")
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorId    String?   @map("actor_id") @db.Uuid
  action     String    @db.VarChar(100)
  resource   String    @db.VarChar(80)
  resourceId String?   @map("resource_id") @db.VarChar(100)
  outcome    String    @db.VarChar(20)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at")
  actor      Employee? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resource, createdAt])
  @@map("audit_logs")
  @@schema("monitoring")
}

model MonitoredService {
  id                   String               @id @default(uuid()) @db.Uuid
  code                 String               @unique @db.VarChar(60)
  name                 String
  endpoint             String
  criticality          String               @default("HIGH") @db.VarChar(20)
  monitoringEnabled    Boolean              @default(true)
  pausedReason         String?              @db.VarChar(500)
  version              Int                  @default(1)
  status               ServiceStatus        @default(RECOVERING)
  lastCheckedAt        DateTime?
  lastLatencyMs        Int?
  lastMessage          String?
  anomalyScore         Float?
  riskLevel            String?              @db.VarChar(20)
  consecutiveFailures  Int                  @default(0)
  consecutiveSuccesses Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  checks               HealthCheck[]
  stateChanges         ServiceStateChange[]

  @@schema("monitoring")
}

model HealthCheck {
  id        String           @id @default(uuid()) @db.Uuid
  serviceId String           @db.Uuid
  status    ServiceStatus
  latencyMs Int
  reachable Boolean          @default(false)
  timedOut  Boolean          @default(false)
  message   String?
  origin    String           @default("SCHEDULED") @db.VarChar(20)
  checkedAt DateTime         @default(now())
  service   MonitoredService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, checkedAt])
  @@schema("monitoring")
}

model ServiceStateChange {
  id         String           @id @default(uuid()) @db.Uuid
  serviceId  String           @db.Uuid
  fromStatus ServiceStatus
  toStatus   ServiceStatus
  reason     String?
  changedAt  DateTime         @default(now())
  service    MonitoredService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, changedAt])
  @@schema("monitoring")
}

model Incident {
  id             String    @id @default(uuid()) @db.Uuid
  serviceKey     String    @db.VarChar(100)
  title          String
  status         String    @db.VarChar(20)
  severity       String    @default("MEDIUM") @db.VarChar(20)
  evidence       Json?
  openedAt       DateTime  @default(now())
  lastObservedAt DateTime  @default(now())
  resolvedAt     DateTime?
  alerts         Alert[]

  @@index([serviceKey, openedAt])
  @@schema("monitoring")
}

model Alert {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @db.Uuid
  kind       String   @db.VarChar(30)
  message    String
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@schema("monitoring")
}

model AssistantConversation {
  id         String             @id @default(uuid()) @db.Uuid
  employeeId String             @map("employee_id") @db.Uuid
  title      String             @db.VarChar(120)
  archivedAt DateTime?          @map("archived_at")
  deletedAt  DateTime?          @map("deleted_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  messages   AssistantMessage[]

  @@index([employeeId, deletedAt, updatedAt])
  @@map("assistant_conversations")
  @@schema("monitoring")
}

model AssistantMessage {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  role           String                @db.VarChar(20)
  content        String                @db.Text
  provider       String?               @db.VarChar(40)
  evidence       Json?
  feedback       String?               @db.VarChar(20)
  createdAt      DateTime              @default(now()) @map("created_at")
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run            AssistantRun?

  @@index([conversationId, createdAt, id])
  @@map("assistant_messages")
  @@schema("monitoring")
}

model AssistantRun {
  id               String           @id @default(uuid()) @db.Uuid
  messageId        String           @unique @map("message_id") @db.Uuid
  provider         String           @db.VarChar(40)
  model            String?          @db.VarChar(120)
  status           String           @db.VarChar(20)
  latencyMs        Int              @map("latency_ms")
  promptTokens     Int?             @map("prompt_tokens")
  completionTokens Int?             @map("completion_tokens")
  promptVersion    String           @map("prompt_version") @db.VarChar(30)
  createdAt        DateTime         @default(now()) @map("created_at")
  message          AssistantMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("assistant_runs")
  @@schema("monitoring")
}

model OperationalOutbox {
  id          String    @id @default(uuid()) @db.Uuid
  incidentId  String    @db.Uuid
  eventType   String    @db.VarChar(40)
  createdAt   DateTime  @default(now())
  queuedAt    DateTime?
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?   @db.VarChar(120)
  notifications Notification[]

  @@index([processedAt, attempts, queuedAt, createdAt])
  @@map("operational_outbox")
  @@schema("monitoring")
}

model Notification {
  id          String @id @default(uuid()) @db.Uuid
  employeeId  String @db.Uuid
  eventId     String @db.Uuid
  incidentId  String @db.Uuid
  eventType   String @db.VarChar(40)
  createdAt   DateTime @default(now())
  readAt      DateTime?
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  event       OperationalOutbox @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([employeeId, eventId])
  @@index([employeeId, createdAt])
  @@map("notifications")
  @@schema("monitoring")
}
