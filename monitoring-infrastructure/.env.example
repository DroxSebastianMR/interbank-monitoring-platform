APP_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=app
APP_DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=app
MONITORING_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=monitoring
APP_JWT_SECRET=replace-app-secret-with-at-least-32-characters
MONITORING_JWT_SECRET=replace-monitor-secret-with-at-least-32-characters
SIMULATION_ENABLED=true
MONITOR_INTERVAL_MS=10000
MONITOR_TIMEOUT_MS=3000
ASSISTANT_PROVIDER=none
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
AI_INTERNAL_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
LOG_LEVEL=info
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:8081
MONITORING_CORS_ORIGINS=http://localhost:5173
# Optional internal analytics. Generate a different random value of >=32 characters.
# Empty = disabled (401/503); never reuse a JWT secret or expose to Vite/mobile.
BANK_ANALYTICS_TOKEN=
# Enable only after applying the additive operational_delivery monitor migration.
MONITORING_DELIVERY_ENABLED=false
# Public status: opt in after reviewing templates and applying migrations.
PUBLIC_STATUS_ENABLED=false
PUBLIC_STATUS_API_URL=http://localhost:4000
